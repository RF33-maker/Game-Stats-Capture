# Supabase project shared with swishassistant.com (anon key is the public,
# browser-safe key — never put the service role key here).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# true = no account, nothing leaves the browser (development only)
VITE_LOCAL_MODE=false
