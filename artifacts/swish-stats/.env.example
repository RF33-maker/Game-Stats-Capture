# Supabase project shared with swishassistant.com (anon key is the public,
# browser-safe key — never put the service role key here).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# true = no account, nothing leaves the browser (development only)
VITE_LOCAL_MODE=false

# --- Where the app lives and who runs it (all optional; defaults shown) ---
# Changing the domain is this plus a redeploy: see docs/domain-cutover.md.
# VITE_SITE_URL=https://scorerstable.swishassistant.com
# VITE_OPERATOR_NAME=Swish Assistant
# VITE_OPERATOR_LEGAL=Automated Athlete Ltd
# VITE_CONTACT_EMAIL=admin@swishassistant.com
# The site games are published to (shown in the copy, e.g. "Linked to Swish profiles")
# VITE_PARTNER_NAME=Swish Assistant
# VITE_PARTNER_URL=https://www.swishassistant.com
